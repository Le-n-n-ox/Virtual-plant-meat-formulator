# Development-only defaults. Never reuse these values in production.
FRONTEND_PORT=3000
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=vpmf
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=virtual_plant_meat_formulator
STREAM_TOKEN_SECRET=dev-only-change-me
STREAM_TOKEN_TTL_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
GIT_SHA=dev
LOG_LEVEL=INFO

# NVIDIA hosted model API (choose a model in NVIDIA's API Catalog)
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=REPLACE_WITH_NVIDIA_MODEL_NAME

# Optional/planned backend integrations; not wired into the current app yet.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
MLFLOW_TRACKING_URI=http://localhost:5000
ARTIFACT_STORE_URL=
SENTRY_DSN=

# Only if Supabase Auth is used:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
