# Development-only defaults. Never reuse these values in production.
FRONTEND_PORT=3000
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=vpmf
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=virtual_plant_meat_formulator
STREAM_TOKEN_SECRET=dev-only-change-me
STREAM_TOKEN_TTL_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
GIT_SHA=dev
LOG_LEVEL=INFO

# Authentication: "local" issues HS256 tokens from POST /api/auth/login (dev/self-hosted);
# "supabase" verifies Supabase JWTs via the project's published signing keys.
AUTH_MODE=local
LOCAL_JWT_SECRET=dev-only-local-jwt-secret-not-for-production
LOCAL_JWT_TTL_SECONDS=3600
# Password for the seeded dev users (python -m app.seed --dev-users); dev only.
DEV_USER_PASSWORD=devpassword123

# Jobs, streams and model governance
MAX_ACTIVE_JOBS_PER_USER=5
MAX_STREAMS_PER_USER=5
MIN_TRAINING_SAMPLES=30

# NVIDIA hosted model API (choose a model in NVIDIA's API Catalog)
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=REPLACE_WITH_NVIDIA_MODEL_NAME
# The language model only explains stored results and evidence; it never produces values.
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_TOKENS=4096

# Optional: create an HDX HAPI app identifier (not a secret API key) to fetch Kenya market prices.
HDX_HAPI_APP_IDENTIFIER=REPLACE_WITH_HDX_HAPI_APP_IDENTIFIER

# Optional/planned backend integrations; not wired into the current app yet.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Only for legacy HS256 Supabase projects:
SUPABASE_JWT_SECRET=
MLFLOW_TRACKING_URI=http://localhost:5000
ARTIFACT_STORE_URL=
SENTRY_DSN=

# Only if Supabase Auth is used:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
